# Chọn 1 provider bạn có key, điền vào đây (file .env — KHÔNG commit)
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Model tutor / judge (dạng provider/model, ví dụ: openai/gpt-4o-mini)
# EVAL_MODEL=deepseek/deepseek-v4-flash
# EVAL_JUDGE_MODEL=openai/gpt-4o-mini

# (Tuỳ chọn) đi qua gateway OpenAI-compatible riêng thay vì gọi thẳng provider:
# EVAL_BASE_URL=https://your-gateway/v1
# EVAL_API_KEY=sk-...

# Chạy eval cho Nova/P-041 thay vì VLearn AI Tutor:
# EVAL_TARGET=p041
# P041_BASE_URL=http://localhost:8000
# Hoặc ghi thẳng endpoint đã deploy: P041_CHAT_URL=https://host/api/v1/assistant/chat
# P041_ACCESS_TOKEN=<JWT access_token nhận từ POST /api/v1/auth/login>
# P041_CURRENT_PAGE=dashboard
# P041_TIMEZONE=Asia/Bangkok
# P041_TIMEOUT_S=60

# Tracing (bài lab yêu cầu gắn MỘT trong hai — code tự nhận backend):
# BRAINTRUST_API_KEY=sk-...        # trace lên Braintrust, project mặc định "ai-evaluation"
# BRAINTRUST_PROJECT=ai-evaluation
# LANGSMITH_API_KEY=lsv2_pt_...    # hoặc trace lên LangSmith (LANGCHAIN_API_KEY cũng được)
# LANGSMITH_PROJECT=ai-evaluation
